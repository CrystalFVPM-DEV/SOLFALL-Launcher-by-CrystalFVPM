; Footer: "SOLFALL Launcher <version>" (template default). Define SOLFALL_BRANDING_LABEL to append text (none in releases).
; SOLFALL installer styling + copy (British English, spec/installer/installer-copy.md). Swappable: edit this file and
; the BMP/ICO files in branding/active/ (regenerated by tools/assets.sh from /workspace/solfall/spec/installer/ + icon/).
; Included by src-tauri/nsis/installer.nsi near the top (before VERSION is defined), so anything that uses ${VERSION}
; or targets ONE page lives in a SOLFALL_COPY_* macro that the custom template inserts right before that page.
!define SHORTCUTNAME "SOLFALL"
!define DISPLAYNAME "SOLFALL Launcher"
Caption "SOLFALL Launcher Setup"
UninstallCaption "SOLFALL Launcher Uninstall"

; Product art is drawn for MUI2's white page with the header image on the RIGHT (header.bmp, not header-left.bmp).
!define MUI_HEADERIMAGE_RIGHT
!define MUI_BGCOLOR "FFFFFF"
!define MUI_TEXTCOLOR "0B0603"
!define MUI_INSTFILESPAGE_COLORS "F2F8FF 0B0603"   ; details log: ink on void
!define MUI_INSTFILESPAGE_PROGRESSBAR "colored"
!define MUI_ABORTWARNING
!define MUI_ABORTWARNING_TEXT "Abort the setup? The SOLFALL Launcher won't be installed."
!define MUI_UNABORTWARNING
!define MUI_UNABORTWARNING_TEXT "Stop uninstalling? The launcher will stay where it is."

!macro SOLFALL_COPY_GLOBAL
!macroend
!macro SOLFALL_COPY_WELCOME
  !define /redef MUI_WELCOMEPAGE_TITLE "Welcome aboard, pilot."
  !define /redef MUI_WELCOMEPAGE_TEXT "This will install the SOLFALL Launcher ${VERSION} on this computer.$\r$\n$\r$\nThe launcher keeps itself up to date and gets you into Solfall in one click. The game itself is served from the web, so there's no game download.$\r$\n$\r$\nIt's best to close other setups before we start. Click Next when you're ready."
!macroend
!macro SOLFALL_COPY_LICENSE
  !define /redef MUI_PAGE_HEADER_TEXT "Licence agreement"
  !define /redef MUI_PAGE_HEADER_SUBTEXT "The small print, before take-off."
  !define /redef MUI_LICENSEPAGE_TEXT_TOP "Scroll down to read the whole thing."
  !define /redef MUI_LICENSEPAGE_TEXT_BOTTOM "If you're happy with the terms, click I Agree. You need to accept them to install the launcher."
!macroend
!macro SOLFALL_COPY_DIRECTORY
  !define /redef MUI_PAGE_HEADER_TEXT "Choose a hangar"
  !define /redef MUI_PAGE_HEADER_SUBTEXT "Where should the launcher live?"
  !define /redef MUI_DIRECTORYPAGE_TEXT_TOP "Setup will install the SOLFALL Launcher in the folder below. To use a different folder, click Browse and pick one. Click Install to continue."
  !define /redef MUI_DIRECTORYPAGE_TEXT_DESTINATION "Install folder"
  !define MUI_PAGE_CUSTOMFUNCTION_SHOW SolfallDirShow
!macroend
; Tauri keeps a (skipped) Start-menu page after Directory, so NSIS labels the button "Next"; the copy says "Install".
Function SolfallDirShow
  GetDlgItem $0 $HWNDPARENT 1
  SendMessage $0 ${WM_SETTEXT} 0 "STR:$(^InstallBtn)"
FunctionEnd
!macro SOLFALL_COPY_INSTFILES
  !define /redef MUI_PAGE_HEADER_TEXT "Installing"
  !define /redef MUI_PAGE_HEADER_SUBTEXT "Getting the launcher ready. Won't be long."
  !define /redef MUI_INSTFILESPAGE_FINISHHEADER_TEXT "All done"
  !define /redef MUI_INSTFILESPAGE_FINISHHEADER_SUBTEXT "The launcher is installed. Click Next."
  !define /redef MUI_INSTFILESPAGE_ABORTHEADER_TEXT "Setup stopped"
  !define /redef MUI_INSTFILESPAGE_ABORTHEADER_SUBTEXT "The launcher wasn't installed. Run setup again whenever you like."
!macroend
!macro SOLFALL_COPY_FINISH
  !define /redef MUI_FINISHPAGE_TITLE "You're cleared for launch."
  !define /redef MUI_FINISHPAGE_TEXT "The SOLFALL Launcher is installed on this computer.$\r$\n$\r$\nClick Finish to close setup."
  !define /redef MUI_FINISHPAGE_RUN_TEXT "Start the SOLFALL Launcher now"
  !define /redef MUI_FINISHPAGE_LINK "solfall.online"
  !define /redef MUI_FINISHPAGE_LINK_LOCATION "https://solfall.online"
!macroend
!macro SOLFALL_COPY_UNCONFIRM
  !define /redef MUI_PAGE_HEADER_TEXT "Uninstall the SOLFALL Launcher"
  !define /redef MUI_PAGE_HEADER_SUBTEXT "Leaving the hangar? No hard feelings."
  !define /redef MUI_UNCONFIRMPAGE_TEXT_TOP "This removes the SOLFALL Launcher from this computer. Your Solfall account lives online, so it isn't affected. Click Uninstall to continue."
  !define /redef MUI_UNCONFIRMPAGE_TEXT_LOCATION "Removing from:"
!macroend
!macro SOLFALL_COPY_UNINSTFILES
  !define /redef MUI_PAGE_HEADER_TEXT "Uninstalling"
  !define /redef MUI_PAGE_HEADER_SUBTEXT "Packing up the launcher."
  !define /redef MUI_INSTFILESPAGE_FINISHHEADER_TEXT "Launcher removed"
  !define /redef MUI_INSTFILESPAGE_FINISHHEADER_SUBTEXT "Solfall is still a click away at solfall.online. Fly safe."
  !define /redef MUI_INSTFILESPAGE_ABORTHEADER_TEXT "Uninstall stopped"
  !define /redef MUI_INSTFILESPAGE_ABORTHEADER_SUBTEXT "The launcher may not have been fully removed. Run the uninstaller again."
!macroend
; Uninstall Finish page (custom template inserts MUI_UNPAGE_FINISH when this macro exists).
!macro SOLFALL_COPY_UNFINISH
  !define /redef MUI_FINISHPAGE_TITLE "Launcher removed."
  !define /redef MUI_FINISHPAGE_TEXT "The SOLFALL Launcher has been removed from this computer.$\r$\n$\r$\nSolfall is still a click away at solfall.online. Fly safe."
!macroend

; Shortcut icon: a dedicated file ($INSTDIR\solfall.ico). 0.1.0 shipped a SUN icon in solfall-launcher.exe at the
; SAME path, so Windows' icon cache can keep showing the sun for "$INSTDIR\solfall-launcher.exe,0"; a new icon path
; plus SHChangeNotify(SHCNE_ASSOCCHANGED) makes Explorer/Start re-read it.
!macro SOLFALL_LNK path
  Delete "${path}"
  CreateShortcut "${path}" "$INSTDIR\${MAINBINARYNAME}.exe" "" "$INSTDIR\solfall.ico" 0
  !insertmacro SetLnkAppUserModelId "${path}"
!macroend
; Remove 0.1.x leftovers ("SolfallLauncher.lnk" / "Solfall Launcher.lnk", optional Start-menu folder) and (re)create
; SOLFALL.lnk with the new icon, also in passive update mode (which normally never touches shortcuts).
!macro SOLFALL_MIGRATE_LNK dir
  StrCpy $R9 0
  ${If} ${FileExists} "${dir}\SolfallLauncher.lnk"
    Delete "${dir}\SolfallLauncher.lnk"
    StrCpy $R9 1
  ${EndIf}
  ${If} ${FileExists} "${dir}\Solfall Launcher.lnk"
    Delete "${dir}\Solfall Launcher.lnk"
    StrCpy $R9 1
  ${EndIf}
  ${If} ${FileExists} "${dir}\SolfallLauncher\*.lnk"
    Delete "${dir}\SolfallLauncher\*.lnk"
    RMDir "${dir}\SolfallLauncher"
    StrCpy $R9 1
  ${EndIf}
  ${If} ${FileExists} "${dir}\${SHORTCUTNAME}.lnk"
    StrCpy $R9 1
  ${EndIf}
  ${If} $R9 = 1
    !insertmacro SOLFALL_LNK "${dir}\${SHORTCUTNAME}.lnk"
  ${EndIf}
!macroend
!macro SOLFALL_SHELL_REFRESH
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)' ; SHCNE_ASSOCCHANGED, SHCNF_IDLIST
!macroend
!macro NSIS_HOOK_POSTINSTALL
  File "/oname=$INSTDIR\solfall.ico" "${INSTALLERICON}"
  !insertmacro SOLFALL_MIGRATE_LNK "$SMPROGRAMS"
  !insertmacro SOLFALL_MIGRATE_LNK "$DESKTOP"
  !insertmacro SOLFALL_SHELL_REFRESH
!macroend
!macro NSIS_HOOK_PREUNINSTALL
  Delete "$INSTDIR\solfall.ico"
  ${If} $DeleteAppDataCheckboxState = 1
    RMDir /r "$INSTDIR\logs"
  ${EndIf}
!macroend
!macro NSIS_HOOK_POSTUNINSTALL
  !insertmacro SOLFALL_SHELL_REFRESH
!macroend
